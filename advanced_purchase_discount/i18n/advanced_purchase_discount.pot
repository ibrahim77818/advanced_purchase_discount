#. module: advanced_purchase_discount
#: model_terms:ir.ui.view,arch_db:advanced_purchase_discount.apd_discount_wizard_view_form
msgid ""
"<span invisible=\"mode != 'prorate'\">\n"
"                        Mode A spreads the discount on the selected lines through their discount percentage. Amounts are\n"
"                        allocated exactly to the cent and checked against the tax engine.\n"
"                    </span>\n"
"                    <span invisible=\"mode != 'manual'\">\n"
"                        Mode B lets you weight the lines, or enter a percentage or an amount for each line.\n"
"                    </span>\n"
"                    <span invisible=\"mode != 'discount_line'\">\n"
"                        Mode C adds one negative line per tax group, using the discount product, prorated on the\n"
"                        untaxed amount of each tax group.\n"
"                    </span>\n"
"                    <span invisible=\"mode != 'tiered'\">\n"
"                        Mode D evaluates vendor agreement discounts and the configured volume tiers automatically.\n"
"                    </span>"
msgstr ""

