<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_apd" model="ir.ui.view">
        <field name="name">purchase.order.form.apd</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_rfq_send'][1]" position="before">
                <field name="apd_discount_enabled" invisible="1"/>
                <button name="action_apd_open_discount_wizard" type="object" string="Discount"
                        icon="fa-percent" groups="purchase.group_purchase_user"
                        attrs="{'invisible': ['|', ('apd_discount_enabled', '=', False), ('state', 'not in', ('draft', 'sent', 'to approve', 'purchase'))]}"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_apd_view_applications" type="object" class="oe_stat_button" icon="fa-percent"
                        attrs="{'invisible': [('apd_application_count', '=', 0)]}">
                    <field name="apd_application_count" widget="statinfo" string="Discounts"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree" position="attributes">
                <attribute name="decoration-info">apd_is_discount_line</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="attributes">
                <attribute name="attrs">{'readonly': ['|', ('qty_invoiced', '!=', 0), ('apd_is_discount_line', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_qty']" position="attributes">
                <attribute name="attrs">{'readonly': [('apd_is_discount_line', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="after">
                <field name="apd_is_discount_line" invisible="1"/>
                <field name="discount" string="Disc.%" optional="show"
                       attrs="{'readonly': ['|', ('qty_invoiced', '!=', 0), ('apd_is_discount_line', '=', True)]}"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="after">
                <field name="discount"/>
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="before">
                <field name="apd_amount_gross" widget="monetary" colspan="2"
                       attrs="{'invisible': [('apd_amount_discount', '=', 0)]}"/>
                <field name="apd_amount_discount" widget="monetary" colspan="2"
                       attrs="{'invisible': [('apd_amount_discount', '=', 0)]}"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_tree_apd" model="ir.ui.view">
        <field name="name">purchase.order.tree.apd</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <field name="amount_untaxed" position="before">
                <field name="apd_amount_discount" sum="Total Discount" optional="hide" widget="monetary"/>
            </field>
        </field>
    </record>
</odoo>
