<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_apd" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.apd</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='invoicing_settings_container']" position="inside">
                <setting id="apd_discount_settings" company_dependent="1"
                         help="Percentage and fixed discounts on purchase orders and vendor bills">
                    <field name="apd_discount_enabled"/>
                    <div class="content-group" invisible="not apd_discount_enabled">
                        <div class="mt16">
                            <label for="apd_discount_product_id" class="o_light_label"/>
                            <field name="apd_discount_product_id" class="w-100"
                                   required="apd_discount_enabled"
                                   context="{'default_detailed_type': 'service', 'default_purchase_ok': True, 'default_sale_ok': False}"/>
                        </div>
                        <div class="mt8">
                            <button name="%(advanced_purchase_discount.action_apd_discount_tier)d" type="action"
                                    string="Volume Discount Tiers" icon="oi-arrow-right" class="btn-link"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
