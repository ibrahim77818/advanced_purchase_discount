<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="apd_discount_tier_company_rule" model="ir.rule">
            <field name="name">Purchase discount tiers: multi-company</field>
            <field name="model_id" ref="model_apd_discount_tier"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="apd_discount_application_company_rule" model="ir.rule">
            <field name="name">Purchase discount log: multi-company</field>
            <field name="model_id" ref="model_apd_discount_application"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="apd_discount_application_line_company_rule" model="ir.rule">
            <field name="name">Purchase discount log details: multi-company</field>
            <field name="model_id" ref="model_apd_discount_application_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('application_id.company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
