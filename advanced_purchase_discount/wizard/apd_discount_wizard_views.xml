<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="apd_discount_wizard_view_form" model="ir.ui.view">
        <field name="name">apd.discount.wizard.form</field>
        <field name="model">apd.discount.wizard</field>
        <field name="arch" type="xml">
            <form string="Apply Discount">
                <field name="purchase_order_id" invisible="1" force_save="1"/>
                <field name="move_id" invisible="1" force_save="1"/>
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="not preview_error">
                    <field name="preview_error" readonly="1" nolabel="1"/>
                </div>
                <group>
                    <group string="Discount">
                        <field name="mode" widget="radio"/>
                        <field name="discount_type" widget="radio" options="{'horizontal': true}"
                               invisible="mode == 'tiered' or (mode == 'manual' and manual_basis != 'weight')"/>
                        <field name="discount_percent"
                               invisible="discount_type != 'percent' or mode == 'tiered' or (mode == 'manual' and manual_basis != 'weight')"/>
                        <field name="discount_amount"
                               invisible="discount_type != 'fixed' or mode == 'tiered' or (mode == 'manual' and manual_basis != 'weight')"/>
                        <field name="prorate_basis" widget="radio"
                               invisible="mode != 'prorate' or discount_type != 'fixed'"/>
                        <field name="manual_basis" widget="radio" invisible="mode != 'manual'"/>
                        <field name="discount_product_id" readonly="1"
                               invisible="mode != 'discount_line'"/>
                        <field name="replace_existing"/>
                    </group>
                    <group string="Preview">
                        <field name="amount_before"/>
                        <field name="amount_discount"/>
                        <field name="amount_after" class="oe_subtotal_footer_separator"/>
                        <field name="preview_residual" invisible="preview_residual == 0"/>
                    </group>
                </group>
                <div class="text-muted mb-2">
                    <span invisible="mode != 'prorate'">
                        Mode A spreads the discount on the selected lines through their discount percentage. Amounts are
                        allocated exactly to the cent and checked against the tax engine.
                    </span>
                    <span invisible="mode != 'manual'">
                        Mode B lets you weight the lines, or enter a percentage or an amount for each line.
                    </span>
                    <span invisible="mode != 'discount_line'">
                        Mode C adds one negative line per tax group, using the discount product, prorated on the
                        untaxed amount of each tax group.
                    </span>
                    <span invisible="mode != 'tiered'">
                        Mode D evaluates vendor agreement discounts and the configured volume tiers automatically.
                    </span>
                </div>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="false" delete="false">
                        <field name="sequence" column_invisible="True"/>
                        <field name="product_id" column_invisible="True" force_save="1"/>
                        <field name="currency_id" column_invisible="True"/>
                        <field name="purchase_line_id" column_invisible="True" force_save="1"/>
                        <field name="move_line_id" column_invisible="True" force_save="1"/>
                        <field name="include" widget="boolean_toggle" string="Use" width="60px"/>
                        <field name="name" force_save="1"/>
                        <field name="quantity" force_save="1"/>
                        <field name="price_unit" force_save="1"/>
                        <field name="current_discount" force_save="1"/>
                        <field name="gross_subtotal" sum="Total"/>
                        <field name="weight"
                               column_invisible="parent.mode != 'manual' or parent.manual_basis != 'weight'"/>
                        <field name="line_percent"
                               column_invisible="parent.mode != 'manual' or parent.manual_basis != 'line_percent'"/>
                        <field name="line_amount" sum="Total"
                               column_invisible="parent.mode != 'manual' or parent.manual_basis != 'line_amount'"/>
                        <field name="new_discount" decoration-bf="new_discount != current_discount"/>
                        <field name="new_subtotal" sum="Total"/>
                    </list>
                </field>
                <field name="preview_message" readonly="1" nolabel="1" invisible="not preview_message"/>
                <group>
                    <field name="note" placeholder="Reason / reference of the discount (kept in the discount log)"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary" data-hotkey="q"/>
                    <button name="action_reset" type="object" string="Remove All Discounts" class="btn-secondary"
                            confirm="All line discounts will be reset and the discount lines removed. Continue?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
