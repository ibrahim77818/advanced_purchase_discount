<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_apd" inherit_id="purchase.report_purchaseorder_document">
        <!-- Odoo 17 already prints a Disc. column: print the high-precision value without trailing zeros. -->
        <xpath expr="//span[@t-field='line.discount']" position="replace">
            <span t-esc="('%.6f' % line.discount).rstrip('0').rstrip('.')"/>
        </xpath>
        <xpath expr="//div[@id='total']//table" position="before">
            <table class="table table-sm table-borderless" t-if="o.apd_amount_discount" name="apd_discount_summary">
                <tr>
                    <td><strong>Gross Amount</strong></td>
                    <td class="text-end">
                        <span t-field="o.apd_amount_gross" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </td>
                </tr>
                <tr>
                    <td>Total Discount</td>
                    <td class="text-end">
                        <span t-field="o.apd_amount_discount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </td>
                </tr>
            </table>
        </xpath>
    </template>
</odoo>
