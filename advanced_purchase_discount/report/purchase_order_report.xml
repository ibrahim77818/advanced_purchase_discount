<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_apd" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//th[@name='th_price_unit']" position="after">
            <th name="th_apd_discount" class="text-end" t-if="any(l.discount for l in o.order_line)">
                <strong>Disc.%</strong>
            </th>
        </xpath>
        <xpath expr="//span[@t-field='line.price_unit']/.." position="after">
            <td class="text-end" t-if="any(l.discount for l in o.order_line)">
                <span class="text-nowrap" t-if="line.discount"
                      t-esc="('%.6f' % line.discount).rstrip('0').rstrip('.')"/>
            </td>
        </xpath>
        <xpath expr="//div[@id='total']//table" position="before">
            <table class="table table-sm" t-if="o.apd_amount_discount" name="apd_discount_summary">
                <tr>
                    <td><strong>Gross Amount</strong></td>
                    <td class="text-end">
                        <span t-field="o.apd_amount_gross" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </td>
                </tr>
                <tr>
                    <td>Total Discount</td>
                    <td class="text-end">
                        <span t-field="o.apd_amount_discount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </td>
                </tr>
            </table>
        </xpath>
    </template>
</odoo>
